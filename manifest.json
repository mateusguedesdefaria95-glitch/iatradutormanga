{
  "manifest_version": 3,
  "name": "MangaTradutor AI",
  "version": "0.1.0",
  "description": "Traduza mangás, manhwas, quadrinhos e imagens diretamente no navegador.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "MangaTradutor AI",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}