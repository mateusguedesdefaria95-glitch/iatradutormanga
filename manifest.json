{
  "manifest_version": 3,
  "name": "MangaTradutor AI",
  "version": "0.5.0",
  "description": "Traduza mangás, manhwas, quadrinhos e imagens com OCR e tradução assistida por IA.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "action": { "default_title": "MangaTradutor AI", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html"
}