{
  "manifest_version": 3,
  "name": "MangaTradutor AI",
  "short_name": "MangaTradutor",
  "version": "0.3.0",
  "description": "Extensão de leitura com detecção de páginas e OCR local opcional.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "action": {"default_title": "MangaTradutor AI", "default_popup": "index.html"},
  "options_page": "options.html",
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}